# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=GadgetCenter

# MySQL (Hostinger: from the Node app on the same server use 127.0.0.1)
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Authentication (use a long random string in production, min 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Marketing and business (public)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=918530613876
NEXT_PUBLIC_PHONE_ORDERS=8530613876
NEXT_PUBLIC_PHONE_REPAIR=8530613876
NEXT_PUBLIC_CONTACT_EMAIL=info@scrollosoft.com
NEXT_PUBLIC_BUSINESS_ADDRESS=Jyotirling Colony, Bondre Nagar, Phulewadi, Kolhapur, Maharashtra 416010

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Razorpay (UPI, cards, netbanking). Key ID is public; never commit the secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
